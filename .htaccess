# Generated/kept in sync with cPanel "Setup Node.js App" (startup = app.js).
PassengerAppRoot "/home/cjfyc2evye0k/public_html/xoraevents.com/xoar"
PassengerBaseURI "/"
PassengerNodejs "/home/cjfyc2evye0k/nodevenv/public_html/xoraevents.com/xoar/24/bin/node"
PassengerAppType node
PassengerStartupFile app.js
PassengerAppLogFile "/home/cjfyc2evye0k/public_html/xoraevents.com/xoar/passenger.log"

Options -Indexes

# cPanel-safe: use <Files> only (DirectoryMatch in .htaccess causes 500).
<IfModule mod_authz_core.c>
  <Files ".env">
    Require all denied
  </Files>
  <Files ".env.local">
    Require all denied
  </Files>
  <Files ".env.deploy">
    Require all denied
  </Files>
  <Files "package-lock.json">
    Require all denied
  </Files>
  <Files "boot-diag.txt">
    Require all denied
  </Files>
  <Files "boot-error.log">
    Require all denied
  </Files>
  <Files "passenger.log">
    Require all denied
  </Files>
</IfModule>

<IfModule !mod_authz_core.c>
  <Files ".env">
    Order allow,deny
    Deny from all
  </Files>
  <Files ".env.local">
    Order allow,deny
    Deny from all
  </Files>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.git(/|$) - [F,L]
  RewriteRule (^|/)\.next(/|$) - [F,L]
  RewriteRule (^|/)node_modules(/|$) - [F,L]
</IfModule>
