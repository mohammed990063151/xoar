# Passenger is required for this vhost — cPanel Node.js App alone is not enough.
<IfModule mod_passenger.c>
  PassengerEnabled on
  PassengerAppType node
  PassengerStartupFile server.js
  PassengerAppRoot /home/cjfyc2evye0k/public_html/xoraevents.com/xoar
  # Must match cPanel nodevenv or Passenger may start the wrong Node and fail boot.
  PassengerNodejs /home/cjfyc2evye0k/nodevenv/public_html/xoraevents.com/xoar/24/bin/node
</IfModule>

Options -Indexes

# cPanel-safe: use <Files> only (DirectoryMatch in .htaccess causes 500).
<IfModule mod_authz_core.c>
  <Files ".env">
    Require all denied
  </Files>
  <Files ".env.local">
    Require all denied
  </Files>
  <Files ".env.deploy">
    Require all denied
  </Files>
  <Files "package-lock.json">
    Require all denied
  </Files>
  <Files "boot-diag.txt">
    Require all denied
  </Files>
</IfModule>

<IfModule !mod_authz_core.c>
  <Files ".env">
    Order allow,deny
    Deny from all
  </Files>
  <Files ".env.local">
    Order allow,deny
    Deny from all
  </Files>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.git(/|$) - [F,L]
  RewriteRule (^|/)\.next(/|$) - [F,L]
  RewriteRule (^|/)node_modules(/|$) - [F,L]
</IfModule>
